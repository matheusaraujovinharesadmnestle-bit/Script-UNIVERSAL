local function destroyEntireHub()
	pcall(function()
		RunService:UnbindFromRenderStep("SolaraAimEspLoop")
	end)
	for _, conn in ipairs(Connections) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(Connections)
	stopFly()
	for plr in pairs(EspElements) do
		clearPlayerEsp(plr)
	end
	if OverlayGui then
		OverlayGui:Destroy()
	end
	pcall(function()
		Rayfield:Destroy()
	end)
end

-- ==================== LOOP PRINCIPAL ====================
local lastFpsTime = tick()
local frameCount = 0
local currentFps = 60

RunService:BindToRenderStep("SolaraAimEspLoop", Enum.RenderPriority.Camera.Value + 1, function()
	local cam = getCamera()
	if not cam then return end

	local vp = cam.ViewportSize
	local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)

	-- FPS & Ping
	frameCount += 1
	if tick() - lastFpsTime >= 0.5 then
		currentFps = math.floor(frameCount / (tick() - lastFpsTime))
		frameCount = 0
		lastFpsTime = tick()
	end

	if VisualsConfig.ShowStats then
		local pingMs = 0
		pcall(function()
			pingMs = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		end)
		StatsLabel.Text = string.format("FPS: %d  |  Ping: %d ms", currentFps, pingMs)
		StatsLabel.Visible = true
	else
		StatsLabel.Visible = false
	end

	local fovColor = AimConfig.FovRainbow and getRainbowColor(0) or Color3.fromRGB(255, 255, 255)
	local chColor = VisualsConfig.CrosshairRainbow and getRainbowColor(0.65) or Color3.fromRGB(255, 255, 255)

	-- Atualiza FOV
	FovFrame.Visible = AimConfig.Enabled and AimConfig.ShowFOV and (AimConfig.FovTransparency < 0.99)
	FovFrame.Size = UDim2.new(0, AimConfig.FOV * 2, 0, AimConfig.FOV * 2)
	FovFrame.Position = UDim2.new(0, center.X, 0, center.Y)
	FovStroke.Color = fovColor
	FovStroke.Transparency = AimConfig.FovTransparency

	-- Atualiza Crosshair Central
	CrosshairHolder.Visible = VisualsConfig.Crosshair
	CrosshairHolder.Position = UDim2.new(0, center.X, 0, center.Y)
	chHorizontal.BackgroundColor3 = chColor
	chVertical.BackgroundColor3 = chColor

	-- Camera FOV
	if VisualsConfig.CamFovEnabled then
		cam.FieldOfView = VisualsConfig.CamFov
	end

	-- Movement
	local localChar = LocalPlayer.Character
	local localHum = localChar and localChar:FindFirstChildOfClass("Humanoid")
	local localRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Head"))

	if localHum and localHum.Health > 0 then
		if MovementConfig.SpeedEnabled then
			localHum.WalkSpeed = MovementConfig.WalkSpeed
		end
		if MovementConfig.JumpEnabled then
			if localHum.UseJumpPower then
				localHum.JumpPower = MovementConfig.JumpPower
			else
				localHum.JumpHeight = math.clamp(MovementConfig.JumpPower * 0.12, 7.2, 120)
			end
		end
	end

	if MovementConfig.NoClip and localChar then
		setCharacterNoClip(localChar, true)
	end

	updateFly(cam)

	-- Aimbot
	if AimConfig.Enabled and UserInputService:IsMouseButtonPressed(AimConfig.TriggerKey) then
		local targetPart, distFromCenter = getBestTarget(cam, center)
		if targetPart and distFromCenter and distFromCenter >= AimConfig.Deadzone then
			local aimPos = getPredictedPosition(targetPart)
			local desiredCFrame = CFrame.new(cam.CFrame.Position, aimPos)
			local alpha = math.clamp(AimConfig.Speed / 100, 0.02, 1)
			cam.CFrame = cam.CFrame:Lerp(desiredCFrame, alpha)
		end
	else
		LockedTargetPlayer = nil
	end

	local originPos = localRoot and localRoot.Position or cam.CFrame.Position

	-- Atualiza ESP por jogador
	local idx = 0
	for plr, data in pairs(EspElements) do
		idx += 1
		local char, head, root, hum = getCharacterParts(plr)
		local playerColor = getEspColorForPlayer(plr, hum, idx)

		local enemyCheckPassed = true
		if EspConfig.TeamCheck and plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team then
			enemyCheckPassed = false
		end

		local active = EspConfig.Enabled and enemyCheckPassed and char ~= nil

		if active then
			if data.Highlight.Adornee ~= char then
				data.Highlight.Adornee = char
			end
			if data.Highlight.Parent ~= char then
				data.Highlight.Parent = char
			end
			data.Highlight.FillColor = playerColor
			data.Highlight.OutlineColor = playerColor
			data.Highlight.FillTransparency = EspConfig.FillTransparency
			data.Highlight.OutlineTransparency = EspConfig.OutlineTransparency
			data.Highlight.Enabled = true
		else
			data.Highlight.Enabled = false
			data.Highlight.Adornee = nil
		end

		if active and head and root and hum then
			local rootScreen, onScreen = cam:WorldToViewportPoint(root.Position)
			local headScreen = cam:WorldToViewportPoint(head.Position)
			local topScreen = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.65, 0))
			local bottomScreen = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.1, 0))

			if onScreen and rootScreen.Z > 0 then
				data.OffscreenDot.Visible = false

				local boxHeight = math.clamp(math.abs(topScreen.Y - bottomScreen.Y), 16, 600)
				local boxWidth = boxHeight * 0.6
				local boxX = rootScreen.X - (boxWidth * 0.5)
				local boxY = topScreen.Y
				local centerX = boxX + (boxWidth * 0.5)

				-- ESP BOX
				if EspConfig.Box and EspConfig.OutlineTransparency < 0.99 then
					data.Box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
					data.Box.Position = UDim2.new(0, boxX, 0, boxY)
					data.BoxStroke.Color = playerColor
					data.BoxStroke.Transparency = EspConfig.OutlineTransparency
					data.Box.Visible = true
				else
					data.Box.Visible = false
				end

				-- ESP LINE
				if EspConfig.Lines then
					local bottomOrigin = Vector2.new(vp.X * 0.5, vp.Y)
					local targetBottom = Vector2.new(rootScreen.X, bottomScreen.Y)
					updateLine(data.Line, bottomOrigin, targetBottom, playerColor, EspConfig.OutlineTransparency)
				else
					data.Line.Visible = false
				end

				-- ESP HEAD DOT
				if EspConfig.HeadDot and EspConfig.OutlineTransparency < 0.99 then
					data.HeadDot.Position = UDim2.new(0, headScreen.X, 0, headScreen.Y)
					data.HeadDot.BackgroundColor3 = playerColor
					data.HeadDot.BackgroundTransparency = EspConfig.OutlineTransparency
					data.HeadDot.Visible = true
				else
					data.HeadDot.Visible = false
				end

				-- ESP HEALTH
				if EspConfig.Health then
					local maxHp = math.max(hum.MaxHealth, 1)
					local hpRatio = math.clamp(hum.Health / maxHp, 0, 1)
					local barWidth = 4
					local barX = boxX - barWidth - 4

					data.HealthBg.Size = UDim2.new(0, barWidth, 0, boxHeight)
					data.HealthBg.Position = UDim2.new(0, barX, 0, boxY)
					data.HealthBg.BackgroundTransparency = math.clamp(EspConfig.OutlineTransparency * 0.5, 0, 0.85)
					data.HealthBg.Visible = true

					data.HealthFill.Size = UDim2.new(1, 0, hpRatio, 0)
					data.HealthFill.BackgroundTransparency = EspConfig.OutlineTransparency
					data.HealthFill.BackgroundColor3 = Color3.fromRGB(
						math.floor(255 * (1 - hpRatio)),
						math.floor(255 * hpRatio),
						80
					)
				else
					data.HealthBg.Visible = false
				end

				-- Nome & Distância acima da caixa
				local nextTopY = boxY - 2

				if EspConfig.Names and EspConfig.OutlineTransparency < 0.99 then
					data.NameLabel.Text = plr.DisplayName ~= "" and plr.DisplayName or plr.Name
					data.NameLabel.Size = UDim2.new(0, math.max(boxWidth + 60, 100), 0, 16)
					data.NameLabel.Position = UDim2.new(0, centerX, 0, nextTopY)
					data.NameLabel.TextColor3 = playerColor
					data.NameLabel.TextTransparency = EspConfig.OutlineTransparency
					data.NameLabel.TextStrokeTransparency = math.clamp(0.25 + EspConfig.OutlineTransparency * 0.75, 0.25, 1)
					data.NameLabel.Visible = true
					nextTopY -= 15
				else
					data.NameLabel.Visible = false
				end

				if EspConfig.Distance and EspConfig.OutlineTransparency < 0.99 then
					local studs = math.floor((root.Position - originPos).Magnitude)
					data.DistanceLabel.Text = tostring(studs) .. " studs"
					data.DistanceLabel.Size = UDim2.new(0, math.max(boxWidth + 60, 100), 0, 15)
					data.DistanceLabel.Position = UDim2.new(0, centerX, 0, nextTopY)
					data.DistanceLabel.TextColor3 = playerColor
					data.DistanceLabel.TextTransparency = EspConfig.OutlineTransparency
					data.DistanceLabel.TextStrokeTransparency = math.clamp(0.25 + EspConfig.OutlineTransparency * 0.75, 0.25, 1)
					data.DistanceLabel.Visible = true
				else
					data.DistanceLabel.Visible = false
				end
			else
				hideEspVisuals(data)

				-- Indicador Offscreen nas bordas da tela
				if EspConfig.Offscreen and EspConfig.OutlineTransparency < 0.99 then
					local dir = Vector2.new(rootScreen.X - center.X, rootScreen.Y - center.Y)
					if rootScreen.Z < 0 then
						dir = -dir
					end
					if dir.Magnitude > 0.01 then
						dir = dir.Unit
						local margin = 28
						local edgeX = math.clamp(center.X + dir.X * (center.X - margin), margin, vp.X - margin)
						local edgeY = math.clamp(center.Y + dir.Y * (center.Y - margin), margin, vp.Y - margin)
						data.OffscreenDot.Position = UDim2.new(0, edgeX, 0, edgeY)
						data.OffscreenDot.BackgroundColor3 = playerColor
						data.OffscreenDot.BackgroundTransparency = EspConfig.OutlineTransparency
						data.OffscreenDot.Visible = true
					end
				end
			end
		else
			hideEspVisuals(data)
		end
	end
end)

