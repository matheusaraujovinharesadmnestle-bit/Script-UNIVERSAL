local function getRainbowColor(offset)
	local hue = (tick() * 0.25 + (offset or 0)) % 1
	return Color3.fromHSV(hue, 0.85, 1)
end

local function getEspColorForPlayer(player, hum, index)
	if EspConfig.ColorMode == "Team" and player.TeamColor then
		return player.TeamColor.Color
	elseif EspConfig.ColorMode == "Health" and hum then
		local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
		return Color3.fromRGB(math.floor(255 * (1 - ratio)), math.floor(255 * ratio), 60)
	elseif EspConfig.ColorMode == "Red" then
		return Color3.fromRGB(255, 65, 65)
	else
		return getRainbowColor(index * 0.12)
	end
end

local function isPartVisible(cam, targetPart, targetChar)
	if not AimConfig.WallCheck then return true end
	local origin = cam.CFrame.Position
	local direction = targetPart.Position - origin

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignoreList = {cam}
	if LocalPlayer.Character then
		table.insert(ignoreList, LocalPlayer.Character)
	end
	params.FilterDescendantsInstances = ignoreList

	local result = workspace:Raycast(origin, direction, params)
	if not result then
		return true
	end
	return result.Instance and result.Instance:IsDescendantOf(targetChar)
end

local function resolveTargetPart(character, screenCenter, cam)
	if not character then return nil end

	local mode = AimConfig.TargetMode
	if mode == "Random" then
		if tick() - LastRandomSwitch > 0.65 then
			LastRandomSwitch = tick()
			local pool = {"Head", "UpperTorso", "HumanoidRootPart"}
			CurrentRandomPart = pool[math.random(1, #pool)]
		end
		mode = CurrentRandomPart
	end

	if mode == "Closest" then
		local candidateNames = {"Head", "UpperTorso", "Torso", "HumanoidRootPart"}
		local bestPart = nil
		local bestDist = math.huge

		for _, partName in ipairs(candidateNames) do
			local part = character:FindFirstChild(partName)
			if part and part:IsA("BasePart") then
				local sp, onScreen = cam:WorldToViewportPoint(part.Position)
				if onScreen and sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - screenCenter).Magnitude
					if d < bestDist then
						bestDist = d
						bestPart = part
					end
				end
			end
		end
		return bestPart
	elseif mode == "Torso" then
		return character:FindFirstChild("UpperTorso")
			or character:FindFirstChild("Torso")
			or character:FindFirstChild("HumanoidRootPart")
			or character:FindFirstChild("Head")
	elseif mode == "HumanoidRootPart" then
		return character:FindFirstChild("HumanoidRootPart")
			or character:FindFirstChild("UpperTorso")
			or character:FindFirstChild("Torso")
			or character:FindFirstChild("Head")
	else
		return character:FindFirstChild("Head")
			or character:FindFirstChild("UpperTorso")
			or character:FindFirstChild("HumanoidRootPart")
	end
end

local function getCharacterParts(player)
	local char = player.Character
	if not char then return nil, nil, nil, nil end
	local head = char:FindFirstChild("Head")
	local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not head or not hum or hum.Health <= 0 then
		return nil, nil, nil, nil
	end
	return char, head, root or head, hum
end

local function getPredictedPosition(part)
	if AimConfig.Prediction <= 0 then
		return part.Position
	end
	local vel = Vector3.zero
	pcall(function()
		vel = part.AssemblyLinearVelocity
	end)
	return part.Position + (vel * AimConfig.Prediction)
end

local function getBestTarget(cam, center)
	-- Sticky Aim: tenta manter o alvo atual se ainda válido e dentro do FOV
	if AimConfig.StickyAim and LockedTargetPlayer and LockedTargetPlayer ~= LocalPlayer then
		local ignoreTeam = AimConfig.TeamCheck and LockedTargetPlayer.Team ~= nil and LocalPlayer.Team ~= nil and LockedTargetPlayer.Team == LocalPlayer.Team
		if not ignoreTeam then
			local char = getCharacterParts(LockedTargetPlayer)
			if char then
				local part = resolveTargetPart(char, center, cam)
				if part and isPartVisible(cam, part, char) then
					local sp, onScreen = cam:WorldToViewportPoint(part.Position)
					if onScreen and sp.Z > 0 then
						local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						if dist <= AimConfig.FOV * 1.15 then
							return part, dist
						end
					end
				end
			end
		end
		LockedTargetPlayer = nil
	end

	local bestPart = nil
	local bestDist = AimConfig.FOV
	local bestPlayer = nil

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local ignoreTeam = AimConfig.TeamCheck and plr.Team ~= nil and LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team
			if not ignoreTeam then
				local char = getCharacterParts(plr)
				if char then
					local part = resolveTargetPart(char, center, cam)
					if part and isPartVisible(cam, part, char) then
						local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
						if onScreen and screenPos.Z > 0 then
							local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
							if dist <= bestDist then
								bestDist = dist
								bestPart = part
								bestPlayer = plr
							end
						end
					end
				end
			end
		end
	end

	LockedTargetPlayer = bestPlayer
	return bestPart, bestDist
end

local function updateLine(frame, fromPos, toPos, color, transparency)
	local delta = toPos - fromPos
	local length = delta.Magnitude
	if length < 1 or transparency >= 0.99 then
		frame.Visible = false
		return
	end
	local mid = (fromPos + toPos) * 0.5
	local angle = math.deg(math.atan2(delta.Y, delta.X))
	frame.Size = UDim2.new(0, length, 0, 1.6)
	frame.Position = UDim2.new(0, mid.X, 0, mid.Y)
	frame.Rotation = angle
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency
	frame.Visible = true
end

