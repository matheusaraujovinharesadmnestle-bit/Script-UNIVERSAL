			Lighting.ClockTime = VisualsConfig.SavedLighting.ClockTime
			Lighting.GlobalShadows = VisualsConfig.SavedLighting.GlobalShadows
		end

		if VisualsConfig.NoFog then
			Lighting.FogStart = 1e6
